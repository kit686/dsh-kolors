{
  "name": "dsh-kolors",
  "version": "0.1.0",
  "description": "Kolors image desk for DeepSeek Harness: a sidebar page that hard-locks the free Kwai-Kolors/Kolors model on SiliconFlow, keeps a local key pool with per-minute and per-day quotas, saves pictures to a folder you choose, and offers a history with a trash and a model tool.",
  "type": "module",
  "icon": "icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node scripts/selftest.mjs && node scripts/clientaudit.mjs && node scripts/pathcheck.mjs",
    "check:live": "node scripts/livecheck.mjs",
    "check:tool": "node scripts/toolschema.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "kolors",
    "siliconflow",
    "image-generation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kit686/dsh-kolors.git"
  },
  "homepage": "https://github.com/kit686/dsh-kolors#readme",
  "bugs": {
    "url": "https://github.com/kit686/dsh-kolors/issues"
  }
}
